# Application Configuration
APP_ENV=development
FREE_MODE=true
LOG_LEVEL=INFO

# AI Provider Configuration
# Options: mock (default), openai, gemini, anthropic
AI_PROVIDER=mock
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Research Provider Configuration
# Options: mock (default)
RESEARCH_PROVIDER=mock

# Database Configuration
DATABASE_URL=sqlite:///./data/history_engine.db

# Content Settings
DEFAULT_VIDEO_DURATION=60
CONFIDENCE_THRESHOLD=75

# Social Media Credentials (Optional - not required for FREE_MODE)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
FACEBOOK_ACCESS_TOKEN=
TIKTOK_ACCESS_TOKEN=
X_API_KEY=
X_API_SECRET=
